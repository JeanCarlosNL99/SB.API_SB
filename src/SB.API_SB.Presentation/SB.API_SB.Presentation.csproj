<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Capa de Presentacion: host de la API (controladores, middlewares,
    configuracion de Swagger, autenticacion y composicion de dependencias).
    Es la unica capa que referencia a todas las demas y actua como
    "Composition Root" del contenedor de inyeccion de dependencias.
  -->
  <PropertyGroup>
    <!--
      El proyecto se compila contra .NET 8 (requisito de la prueba). RollForward
      permite ejecutarlo tambien en maquinas donde solo esta instalado un runtime
      mayor (.NET 9 / .NET 10) sin cambiar el TargetFramework.
    -->
    <RollForward>LatestMajor</RollForward>
    <UserSecretsId>sb-api-sb-presentation</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SB.API_SB.Application\SB.API_SB.Application.csproj" />
    <ProjectReference Include="..\SB.API_SB.Domain\SB.API_SB.Domain.csproj" />
    <ProjectReference Include="..\SB.API_SB.Infrastructure\SB.API_SB.Infrastructure.csproj" />
    <ProjectReference Include="..\SB.API_SB.Services\SB.API_SB.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      La base de datos de texto plano vive dentro del propio proyecto y se copia
      al directorio de salida para que la API funcione sin configuracion previa.
    -->
    <None Include="Database\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
