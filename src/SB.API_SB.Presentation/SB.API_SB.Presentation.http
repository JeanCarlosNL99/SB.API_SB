@baseUrl = http://localhost:5080
@userName = administrador
@password = Sb2024Admin

### Estado del servicio (anonimo)
GET {{baseUrl}}/api/estado

### Iniciar sesion y guardar el token
# @name iniciarSesion
POST {{baseUrl}}/api/autenticacion/iniciar-sesion
Content-Type: application/json

{
  "userName": "{{userName}}",
  "password": "{{password}}"
}

@token = {{iniciarSesion.response.body.accessToken}}

### Sesion actual
GET {{baseUrl}}/api/autenticacion/sesion-actual
Authorization: Bearer {{token}}

### Consultar entidades gubernamentales con filtros
GET {{baseUrl}}/api/entidades-gubernamentales?name=Instituto&pageNumber=1&pageSize=10
Authorization: Bearer {{token}}

### Catalogos de categoria, sector y poder del Estado
GET {{baseUrl}}/api/entidades-gubernamentales/catalogos
Authorization: Bearer {{token}}

### Crear entidad gubernamental
POST {{baseUrl}}/api/entidades-gubernamentales
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Instituto Nacional de Ejemplo",
  "category": "Organismo Descentralizado Funcionalmente",
  "stateBranch": "Poder Ejecutivo",
  "sector": "Hacienda"
}

### Consultar departamentos
GET {{baseUrl}}/api/departamentos
Authorization: Bearer {{token}}

### Consultar empleados con filtros por nombre, departamento y estado
GET {{baseUrl}}/api/empleados?name=Martinez&status=Active&pageNumber=1&pageSize=10
Authorization: Bearer {{token}}

### Crear empleado asalariado
POST {{baseUrl}}/api/empleados
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "Salaried",
  "firstName": "Ana",
  "paternalLastName": "Martinez",
  "socialSecurityNumber": "001-1111111-1",
  "departmentId": "REEMPLAZAR_POR_GUID_DE_DEPARTAMENTO",
  "status": "Active",
  "weeklySalary": 35000
}

### Crear empleado por horas (con horas extras)
POST {{baseUrl}}/api/empleados
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "Hourly",
  "paternalLastName": "Rodriguez",
  "socialSecurityNumber": "001-2222222-2",
  "departmentId": "REEMPLAZAR_POR_GUID_DE_DEPARTAMENTO",
  "status": "Active",
  "hourlyWage": 300,
  "hoursWorked": 45
}

### Crear empleado asalariado por comision
POST {{baseUrl}}/api/empleados
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "type": "BaseSalariedCommission",
  "firstName": "Carmen",
  "paternalLastName": "Guzman",
  "socialSecurityNumber": "001-3333333-3",
  "departmentId": "REEMPLAZAR_POR_GUID_DE_DEPARTAMENTO",
  "status": "Active",
  "grossSales": 180000,
  "commissionRate": 0.05,
  "baseSalary": 20000
}

### Reporte semanal de nomina
GET {{baseUrl}}/api/reportes-nomina/semanal?soloEmpleadosActivos=true
Authorization: Bearer {{token}}

### Consultar usuarios (requiere rol Administrador)
GET {{baseUrl}}/api/usuarios
Authorization: Bearer {{token}}

### Consultar roles disponibles
GET {{baseUrl}}/api/usuarios/roles
Authorization: Bearer {{token}}

### Consultar companias
GET {{baseUrl}}/api/companias
Authorization: Bearer {{token}}

### Crear compania
POST {{baseUrl}}/api/companias
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Compania de Ejemplo, S. A.",
  "taxIdentificationNumber": "101-99999-9"
}

### Vista previa del calculo de una semana (no persiste nada)
GET {{baseUrl}}/api/nomina/vista-previa?companyId=REEMPLAZAR_POR_GUID&year=2026&weekNumber=34&onlyActiveEmployees=true
Authorization: Bearer {{token}}

### Semanas ya pagadas por la compania en el ano
GET {{baseUrl}}/api/nomina/semanas-generadas?companyId=REEMPLAZAR_POR_GUID&year=2026
Authorization: Bearer {{token}}

### Generar el pago de la semana
# Repetir esta peticion devuelve HTTP 409: una semana solo se paga una vez.
POST {{baseUrl}}/api/nomina/ejecuciones
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "companyId": "REEMPLAZAR_POR_GUID",
  "year": 2026,
  "weekNumber": 34,
  "onlyActiveEmployees": true
}

### Historial de pagos semanales
GET {{baseUrl}}/api/nomina/ejecuciones?year=2026&includeCancelled=true&pageNumber=1&pageSize=10
Authorization: Bearer {{token}}

### Detalle de una nomina generada
GET {{baseUrl}}/api/nomina/ejecuciones/REEMPLAZAR_POR_GUID
Authorization: Bearer {{token}}

### Anular una nomina (requiere rol Administrador)
POST {{baseUrl}}/api/nomina/ejecuciones/REEMPLAZAR_POR_GUID/anular
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "Se cargaron horas incorrectas en el periodo."
}

### Archivos del registro de eventos (requiere rol Administrador)
GET {{baseUrl}}/api/registro-eventos/archivos
Authorization: Bearer {{token}}

### Registro de eventos filtrado (requiere rol Administrador)
GET {{baseUrl}}/api/registro-eventos?minimumLevel=Warning&maximumEntries=50
Authorization: Bearer {{token}}
