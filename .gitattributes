# Normaliza los finales de linea para que el repositorio sea consistente
# independientemente del sistema operativo de cada desarrollador.
* text=auto eol=lf

# Archivos que deben conservar finales de linea de Windows.
*.sln text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf

# Archivos binarios: sin conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.db binary
